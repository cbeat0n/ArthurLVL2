 }
 
+/* Phones: less padding, boxes stack tighter */
+@media (max-width: 600px) {
+  body { padding: 1rem; }
+  h1 { font-size: 1.6rem; }
+  .info-box { margin: 0.3rem; padding: 0.6rem 0.9rem; }
+  .plot-container { padding: 0.4rem; }
+}
