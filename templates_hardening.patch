+  <script>
+  (function () {
+    // Mirror of utils/granularity.py so a bad pairing can't be chosen. The server checks again.
+    // A horizon MxQn lasts 60*x + 15*n seconds and must be a whole number of intake candles.
+    const INTAKE_SECONDS = { S5: 5, S10: 10, S15: 15, S30: 30 };
+    const intake = document.getElementById("intake");
+    const horizon = document.getElementById("horizon");
+    const note = document.getElementById("formNote");
+
+    function horizonSeconds(value) {
+      const m = /^M(\d+)Q([0-3])$/.exec(value);
+      return m ? 60 * parseInt(m[1]) + 15 * parseInt(m[2]) : NaN;
+    }
+
+    function applyIntake() {
+      const step = INTAKE_SECONDS[intake.value];
+      let firstValid = null;
+      Array.from(horizon.options).forEach(function (opt) {
+        const ok = horizonSeconds(opt.value) % step === 0;
+        opt.disabled = !ok;
+        if (ok && !firstValid) firstValid = opt;
+      });
+      if (horizon.selectedOptions[0] && horizon.selectedOptions[0].disabled && firstValid) {
+        horizon.value = firstValid.value;
+        note.textContent = "Horizon changed to " + firstValid.text + ": " + intake.value + " candles need a horizon that is a whole number of candles.";
+      } else {
+        note.textContent = "";
+      }
+    }
+    intake.addEventListener("change", applyIntake);
+    applyIntake();
+
+    // One start per click. The server ignores a second start, but this stops a double click opening two tabs.
+    const form = document.getElementById("startForm");
+    const button = document.getElementById("startButton");
+    form.addEventListener("submit", function () {
+      button.disabled = true;
+      setTimeout(function () { button.disabled = false; }, 4000);
+    });
+    window.addEventListener("pageshow", function () { button.disabled = false; applyIntake(); });
+  })();
+  </script>
+
 </body>
 </html>
 
